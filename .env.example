# Alfred needs NO configuration to start. Run `docker compose up -d --build`
# and finish setup in the browser — the admin account, organisation name,
# email provider, alert tuning, groups and optional Microsoft sign-in are all
# configured in the app and stored in the database.
#
# Everything below is optional. Copy this file to .env only if you want to
# override a default.

# ── Host port the dashboard (and agent ingest endpoint) is exposed on ─────────
ALFRED_PORT=8420

# ── Encryption key for secrets stored in the database ────────────────────────
# Leave blank: on first boot the backend generates one, prints it to the
# container logs, and stores it in the database. An admin can also reveal it
# later under Settings. Set it here (64 hex chars, `openssl rand -hex 32`) to
# keep the key out of the database, or for a scripted/reproducible deploy.
ALFRED_MASTER_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Postgres runs on the internal compose network only and is not published, so
# it uses trust auth by default. Set a password (and add a ports mapping in
# docker-compose.yml) only if you deliberately expose the database.
# POSTGRES_PASSWORD=
# POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# ── Skip the first-run wizard (scripted deploys only) ────────────────────────
# Set both to create the admin account non-interactively. Everything else is
# still configured in Settings afterwards.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ── Session signing key (optional) ──────────────────────────────────────────
# Derived from ALFRED_MASTER_KEY when unset. Set it only if you need sessions
# to survive rotating the master key independently.
# JWT_SECRET=
